# Chiave API di Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Come JARVIS si rivolge a te (es. "signore", "signora", "Tony")
JARVIS_NOME_UTENTE=signore

# Modello e profondità di ragionamento (low, medium, high, xhigh, max)
JARVIS_MODELLO=claude-opus-5-5
JARVIS_SFORZO=medium

# Voce: true/false. Voce neurale di Edge (it-IT-DiegoNeural, it-IT-GiuseppeNeural, it-IT-ElsaNeural, it-IT-IsabellaNeural)
JARVIS_VOCE=true
JARVIS_VOCE_EDGE=it-IT-DiegoNeural

# Avvia direttamente in ascolto vocale e parola di attivazione
JARVIS_ASCOLTO=false
JARVIS_PAROLA_ATTIVAZIONE=jarvis

# Chiedi conferma prima di comandi, script, eliminazioni, spegnimento (consigliato: true)
JARVIS_CONFERMA=true

# Ricerca web integrata
JARVIS_RICERCA_WEB=true
